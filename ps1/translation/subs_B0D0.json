  },
  {
   "id": "B0D0_1041",
   "file": 6,
   "chan": 1,
   "start": 4585,
   "end": 5625,
   "dur": 6.9,
   "speaker": "Teller",
   "en": "That's up to you. If you have no memories, make new ones.",
