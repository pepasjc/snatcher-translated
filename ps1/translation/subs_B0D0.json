  },
  {
   "id": "B0D0_1035",
   "file": 70,
   "chan": 0,
   "start": 49176,
   "end": 49544,
   "dur": 2.5,
   "speaker": "Gillian",
   "en": "Really? Maybe it's my imagination.",
   "enabled": true,
   "last": true
  },
  {
   "id": "B0D0_1036",
   "file": 1,
   "chan": 1,
   "start": 2409,
   "end": 2569,
   "dur": 1.1,
   "speaker": "Gillian",
   "en": "Gulp!",
   "enabled": true
  },
  {
   "id": "B0D0_1037",
   "file": 2,
   "chan": 1,
   "start": 2585,
   "end": 3561,
   "dur": 6.5,
   "speaker": "Teller",
   "en": "And you... Yes, you've lost your memory.",
   "enabled": true
  },
  {
   "id": "B0D0_1038",
   "file": 3,
   "chan": 1,
   "start": 3577,
   "end": 3705,
   "dur": 0.9,
   "speaker": "Gillian",
   "en": "How did you know?",
   "enabled": true
  },
  {
   "id": "B0D0_1039",
   "file": 4,
   "chan": 1,
   "start": 3721,
   "end": 4217,
   "dur": 3.3,
   "speaker": "Teller",
   "en": "Retinal readings reveal everything.",
   "enabled": true
  },
  {
   "id": "B0D0_1040",
   "file": 5,
   "chan": 1,
   "start": 4233,
   "end": 4569,
   "dur": 2.2,
   "speaker": "Gillian",
   "en": "Then how can I make things work with her?",
