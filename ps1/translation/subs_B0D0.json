   "by_text": true
  },
  {
   "id": "B0D0_1052",
   "file": 17,
   "chan": 1,
   "start": 12585,
   "end": 12969,
   "dur": 2.6,
   "speaker": "Gillian",
   "en": "Then what about me? What about Jamie and me?",
   "enabled": true
  },
  {
   "id": "B0D0_1053",
   "file": 18,
   "chan": 1,
   "start": 12985,
   "end": 13625,
   "dur": 4.3,
   "speaker": "Metal Gear",
   "en": "As she said, you make your own future.",
   "enabled": true,
   "last": true,
   "by_text": true
  }
