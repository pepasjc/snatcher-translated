  {
   "id": "B0D0_1042",
   "file": 7,
   "chan": 1,
   "start": 5641,
   "end": 6009,
   "dur": 2.5,
   "speaker": "Gillian",
   "en": "Is it that simple?",
   "enabled": true
  },
  {
   "id": "B0D0_1043",
   "file": 8,
   "chan": 1,
   "start": 6025,
   "end": 6442,
   "dur": 2.8,
   "speaker": "Teller",
   "en": "You make your own future!",
   "enabled": true
  },
  {
   "id": "B0D0_1043b",
   "file": 8,
   "chan": 1,
   "start": 6554,
   "end": 6673,
   "dur": 0.8,
   "speaker": "Teller",
   "en": "Hmm?",
