  },
  {
   "id": "B0D0_1046",
   "file": 11,
   "chan": 1,
   "start": 7977,
   "end": 8489,
   "dur": 3.4,
   "speaker": "Metal Gear",
   "en": "Gillian, did you really believe her?",
   "enabled": true,
   "by_text": true
  },
  {
   "id": "B0D0_1047",
   "file": 12,
   "chan": 1,
   "start": 8505,
   "end": 8825,
   "dur": 2.1,
   "speaker": "Gillian",
   "en": "Of course. She got so much right.",
   "enabled": true
  },
  {
   "id": "B0D0_1048",
   "file": 13,
   "chan": 1,
   "start": 8841,
   "end": 9417,
   "dur": 3.8,
   "speaker": "Metal Gear",
   "en": "Anyone could do that. She read your retinal pattern, didn't she?",
   "enabled": true,
   "by_text": true
  },
  {
   "id": "B0D0_1049",
   "file": 14,
   "chan": 1,
   "start": 9433,
   "end": 9593,
   "dur": 1.1,
   "speaker": "Gillian",
   "en": "So what?",
   "enabled": true
  },
  {
   "id": "B0D0_1050",
   "file": 15,
   "chan": 1,
   "start": 9609,
   "end": 10204,
   "dur": 7.8,
   "speaker": "Metal Gear",
   "en": "Everyone's retinal pattern is registered in Alphaville.",
   "enabled": true,
   "by_text": true
  },
  {
   "id": "B0D0_1050b",
   "file": 15,
   "chan": 1,
   "start": 10204,
   "end": 10502,
   "dur": 2.7,
   "speaker": "Metal Gear",
   "en": "Yours too, Gillian.",
   "enabled": true,
   "by_text": true
  },
  {
   "id": "B0D0_1050c",
   "file": 15,
   "chan": 1,
   "start": 10502,
   "end": 11101,
   "dur": 5.0,
   "speaker": "Metal Gear",
   "en": "She scanned your retina and used it",
   "enabled": true,
   "by_text": true
  },
  {
   "id": "B0D0_1050d",
   "file": 15,
   "chan": 1,
   "start": 11101,
   "end": 11625,
   "dur": 5.7,
   "speaker": "Metal Gear",
   "en": "to look up your details in the databank.",
   "enabled": true,
   "by_text": true
  },
  {
   "id": "B0D0_1051",
   "file": 16,
   "chan": 1,
   "start": 11641,
   "end": 12569,
   "dur": 6.2,
   "speaker": "Metal Gear",
   "en": "No fortune-telling. She checked your records. She's just a hacker.",
