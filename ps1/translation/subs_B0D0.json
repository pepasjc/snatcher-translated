  },
  {
   "id": "B0D0_1033",
   "file": 68,
   "chan": 0,
   "start": 48104,
   "end": 48360,
   "dur": 1.7,
   "speaker": "Gillian",
   "en": "Ha ha. Disturbed?",
   "enabled": true
  },
  {
   "id": "B0D0_1034",
   "file": 69,
   "chan": 0,
   "start": 48376,
   "end": 49160,
   "dur": 5.2,
   "speaker": "Teller",
   "en": "Divorce, separation... Your marriage has gone wrong.",
