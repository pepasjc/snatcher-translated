  },
  {
   "id": "B0D0_1043c",
   "file": 8,
   "chan": 1,
   "start": 6823,
   "end": 7129,
   "dur": 2.0,
   "speaker": "Teller",
   "en": "Next, please!",
   "enabled": true
  },
  {
   "id": "B0D0_1044",
   "file": 9,
   "chan": 1,
   "start": 7145,
   "end": 7305,
   "dur": 1.1,
   "speaker": "Gillian",
   "en": "Thank you.",
   "enabled": true
  },
  {
   "id": "B0D0_1045",
   "file": 10,
   "chan": 1,
   "start": 7321,
   "end": 7961,
   "dur": 8.6,
   "speaker": "Gillian",
   "en": "Hear that, Metal? I doubted fortune-telling, but that was impressive.",
