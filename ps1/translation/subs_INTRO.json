 },
 "cues": [
  {
   "id": "INTRO_news_00",
   "file": 2,
   "chan": 2,
   "start": 114833,
   "end": 116018,
   "dur": 7.9,
   "speaker": "",
   "en": "June 6th, 1991. Moscow, the Chernoton Research Institute. A mysterious explosion.",
   "enabled": true,
   "pic_bottom": 176,
   "y": 9,
   "over": false
  },
  {
   "id": "INTRO_news_01",
   "file": 2,
   "chan": 2,
   "start": 116048,
   "end": 116976,
   "dur": 6.2,
   "speaker": "",
   "en": "The germ weapon under secret development there, Lucifer Alpha, leaked into the atmosphere.",
   "enabled": true,
   "pic_bottom": 176,
   "y": 9,
   "over": false
  },
  {
   "id": "INTRO_news_02",
   "file": 2,
   "chan": 2,
   "start": 116976,
   "end": 117142,
   "dur": 1.1,
   "speaker": "",
   "en": "A biohazard.",
   "enabled": true,
   "pic_bottom": 176,
   "y": 9,
   "over": false
  },
  {
   "id": "INTRO_news_03",
   "file": 2,
   "chan": 2,
   "start": 117202,
   "end": 118342,
   "dur": 7.6,
   "speaker": "",
   "en": "Riding the updrafts, Lucifer Alpha wiped out Eastern Europe and some 80% of the Eurasian continent.",
   "enabled": true,
   "pic_bottom": 229,
   "y": 11,
   "over": true
  },
  {
   "id": "INTRO_news_05",
   "file": 2,
   "chan": 2,
   "start": 118462,
   "end": 118897,
   "dur": 2.9,
   "speaker": "",
   "en": "Half the world died.",
   "enabled": true,
   "pic_bottom": 229,
   "y": 43,
   "over": true
  },
  {
   "id": "INTRO_news_06",
   "file": 2,
   "chan": 2,
   "start": 119092,
   "end": 119826,
   "dur": 4.9,
   "speaker": "",
   "en": "The greatest biohazard in history would later be called the Catastrophe.",
   "enabled": true,
   "pic_bottom": 229,
   "y": 11,
   "over": true
  },
  {
   "id": "INTRO_news_07",
   "file": 2,
   "chan": 2,
   "start": 120051,
   "end": 120863,
   "dur": 5.4,
   "speaker": "",
   "en": "But who could have imagined that half a century later a true biohazard,",
   "enabled": true,
   "pic_bottom": 229,
   "y": 11,
   "over": true
  },
  {
   "id": "INTRO_news_08",
   "file": 2,
   "chan": 2,
   "start": 120863,
   "end": 121266,
   "dur": 2.7,
   "speaker": "",
   "en": "more terrible still, would come?",
   "enabled": true,
   "pic_bottom": 229,
   "y": 27,
   "over": true
  },
  {
   "id": "INTRO_news_09",
   "file": 2,
   "chan": 2,
   "start": 121506,
   "end": 122285,
   "dur": 5.2,
   "speaker": "",
   "en": "Fifty years later. Humanity faced an unprecedented crisis:",
   "enabled": true,
   "pic_bottom": 136,
   "y": 0,
   "over": false
  },
  {
   "id": "INTRO_news_10",
   "file": 2,
   "chan": 2,
   "start": 122360,
   "end": 122825,
   "dur": 3.1,
   "speaker": "",
   "en": "the appearance of a mysterious life form, the bioroids.",
   "enabled": true,
   "pic_bottom": 191,
   "y": 24,
   "over": false
  },
  {
   "id": "INTRO_news_11",
   "file": 2,
   "chan": 2,
   "start": 122900,
   "end": 123920,
   "dur": 6.8,
   "speaker": "",
   "en": "Nationality, purpose, identity, all unknown. A nation's new weapon? Invaders from beyond?",
   "enabled": true,
   "pic_bottom": 230,
   "y": 11,
   "over": true
  },
  {
   "id": "INTRO_news_12",
   "file": 2,
   "chan": 2,
   "start": 124055,
   "end": 125089,
   "dur": 6.9,
   "speaker": "",
   "en": "They appear in winter, kill, secretly take their victims' places and infiltrate society.",
   "enabled": true,
   "pic_bottom": 238,
   "y": 11,
   "over": true
  },
  {
   "id": "INTRO_news_13",
   "file": 2,
   "chan": 2,
   "start": 125269,
   "end": 126049,
   "dur": 5.2,
   "speaker": "",
   "en": "They wear artificial skin. They sweat. They can even bleed.",
   "enabled": true,
   "pic_bottom": 238,
   "y": 27,
   "over": true
  },
  {
   "id": "INTRO_news_14",
   "file": 2,
   "chan": 2,
   "start": 126064,
   "end": 126559,
   "dur": 3.3,
   "speaker": "",
   "en": "Extremely intelligent, and utterly ruthless.",
   "enabled": true,
   "pic_bottom": 238,
   "y": 27,
   "over": true
  },
  {
   "id": "INTRO_news_15",
   "file": 2,
   "chan": 2,
   "start": 126694,
   "end": 127054,
   "dur": 2.4,
   "speaker": "",
   "en": "They are almost impossible to tell from the originals.",
   "enabled": true,
   "pic_bottom": 238,
   "y": 27,
   "over": true
  },
  {
   "id": "INTRO_news_16",
   "file": 2,
   "chan": 2,
   "start": 127174,
   "end": 127472,
   "dur": 4.7,
   "speaker": "",
   "en": "Because they take people's bodies and replace them, they came to be called... Snatchers.",
   "enabled": true,
   "pic_bottom": 238,
   "y": 11,
   "over": true
  },
  {
   "id": "INTRO_news_16b",
   "file": 2,
   "chan": 2,
   "start": 127472,
   "end": 127879,
   "dur": 4.7,
   "speaker": "",
   "en": "Because they take people's bodies and replace them, they came to be called... Snatchers.",
   "enabled": true,
   "last": true,
   "noband": true,
   "pic_bottom": 238,
   "y": 11,
   "over": true
  },
  {
   "id": "INTRO_gillian_00",
   "file": 3,
   "chan": 1,
   "start": 144656,
   "end": 145166,
   "dur": 3.4,
   "speaker": "",
   "en": "Gillian Seed. He's estimated to be 31.",
   "enabled": true,
   "pic_bottom": 159,
   "y": 0,
   "over": false
  },
  {
   "id": "INTRO_gillian_01",
   "file": 3,
   "chan": 1,
   "start": 145331,
   "end": 145931,
   "dur": 4.0,
   "speaker": "",
   "en": "Three years ago, together with his wife Jamie Seed,",
   "enabled": true,
   "pic_bottom": 159,
   "y": 0,
   "over": false
  },
  {
   "id": "INTRO_gillian_02",
   "file": 3,
   "chan": 1,
   "start": 145931,
   "end": 146531,
   "dur": 4.0,
   "speaker": "",
   "en": "he was found in the Siberian neutral zone by the 17th Siberian survey team.",
   "enabled": true,
   "pic_bottom": 159,
   "y": 0,
   "over": false
  },
  {
   "id": "INTRO_gillian_03",
   "file": 3,
   "chan": 1,
   "start": 146531,
   "end": 147640,
   "dur": 7.4,
   "speaker": "",
   "en": "He suffers from amnesia to this day. His past is a deep mystery.",
   "enabled": true,
   "pic_bottom": 159,
   "y": 0,
   "over": false
  },
  {
   "id": "INTRO_gillian_04",
   "file": 3,
   "chan": 1,
   "start": 147700,
   "end": 148180,
   "dur": 3.2,
   "speaker": "",
   "en": "Separated from Jamie for two years.",
   "enabled": true,
   "pic_bottom": 159,
   "y": 0,
   "over": false
  },
  {
   "id": "INTRO_gillian_05",
   "file": 3,
   "chan": 1,
   "start": 148180,
   "end": 149275,
   "dur": 7.3,
   "speaker": "",
   "en": "After long special training in the army, as of today he is posted to Neo Kobe City as a JUNKER.",
   "enabled": true,
   "last": true,
   "pic_bottom": 159,
   "y": 0,
   "over": false
  }
 ]
}