   "file": 18,
   "chan": 6,
   "start": 131526,
   "end": 132214,
   "dur": 6.5,
   "speaker": "",
   "en": "the skills he developed as a Science Cop.",
   "enabled": true
  },
  {
   "id": "B140_replay_01bt",
   "file": 18,
   "chan": 6,
   "start": 132214,
   "end": 133150,
   "dur": 8.7,
   "speaker": "",
   "en": "That's why they were using sunscreen even in midwinter.",
   "enabled": true
  },
  {
