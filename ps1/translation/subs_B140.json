  },
  {
   "id": "B140_replay_01bh",
   "file": 18,
   "chan": 6,
   "start": 122941,
   "end": 123739,
   "dur": 9.0,
   "speaker": "",
   "en": "It appears that this discovery was what got Gibson killed",
   "enabled": true
  },
  {
   "id": "B140_replay_01bi",
   "file": 18,
   "chan": 6,
   "start": 123739,
   "end": 123958,
   "dur": 2.7,
   "speaker": "",
   "en": "by the Snatchers.",
   "enabled": true
  },
  {
   "id": "B140_replay_01bj",
   "file": 18,
   "chan": 6,
   "start": 123958,
   "end": 125053,
   "dur": 10.7,
   "speaker": "",
   "en": "Their weakness lies in the differences between them and real humans.",
   "enabled": true
  },
  {
   "id": "B140_replay_01bk",
   "file": 18,
   "chan": 6,
   "start": 125053,
   "end": 125793,
   "dur": 8.8,
   "speaker": "",
   "en": "Their artificial skin is sensitive to ultraviolet light.",
   "enabled": true
  },
  {
   "id": "B140_replay_01bl",
   "file": 18,
   "chan": 6,
   "start": 125793,
   "end": 126678,
   "dur": 9.1,
   "speaker": "",
   "en": "Long exposure causes cancer resembling malignant melanoma.",
   "enabled": true
  },
  {
   "id": "B140_replay_01bm",
   "file": 18,
   "chan": 6,
   "start": 126678,
   "end": 127614,
   "dur": 6.3,
   "speaker": "",
   "en": "This limits where and when they can act.",
   "enabled": true
  },
  {
   "id": "B140_replay_01bn",
   "file": 18,
   "chan": 6,
   "start": 127614,
   "end": 128489,
   "dur": 9.6,
   "speaker": "",
   "en": "Only at night, in midwinter when daylight hours are shortest.",
   "enabled": true
  },
  {
   "id": "B140_replay_01bo",
   "file": 18,
   "chan": 6,
   "start": 128489,
   "end": 129530,
   "dur": 10.3,
   "speaker": "",
   "en": "Their artificial skin takes at least six months to become stable.",
   "enabled": true
  },
  {
   "id": "B140_replay_01bp",
   "file": 18,
   "chan": 6,
   "start": 129530,
   "end": 130208,
   "dur": 6.9,
   "speaker": "",
   "en": "They are vulnerable during those six months.",
   "enabled": true
  },
  {
   "id": "B140_replay_01bq",
   "file": 18,
   "chan": 6,
   "start": 130208,
   "end": 130886,
   "dur": 8.7,
   "speaker": "",
   "en": "They must avoid ultraviolet light throughout that time.",
   "enabled": true
  },
  {
   "id": "B140_replay_01br",
   "file": 18,
   "chan": 6,
   "start": 130886,
   "end": 131526,
   "dur": 5.8,
   "speaker": "",
   "en": "Gibson must have uncovered this using",
   "enabled": true
  },
  {
