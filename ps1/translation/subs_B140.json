   "enabled": true
  },
  {
   "id": "B140_replay_01bf",
   "file": 18,
   "chan": 6,
   "start": 121730,
   "end": 122338,
   "dur": 6.9,
   "speaker": "",
   "en": "Meanwhile, a floppy disk containing Gibson's",
   "enabled": true
  },
  {
   "id": "B140_replay_01bg",
   "file": 18,
   "chan": 6,
   "start": 122338,
   "end": 122941,
   "dur": 8.2,
   "speaker": "",
   "en": "research revealed a major weakness of the Snatchers.",
